# Auto detect text files and force LF
* text=auto eol=lf

# Windows scripts need CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.jar binary
*.class binary
*.zip binary
*.ttf binary
*.otf binary
*.ogg binary
*.mp3 binary
*.wav binary

# Preserve exact upstream license/notice bytes referenced by the native-physics SHA-256 index.
thirdparty/licenses/native_physics/**/*.txt -text !eol whitespace=-blank-at-eof,cr-at-eol
