# User-specific stuff
.idea/*
!.idea/icon.svg
!.idea/dictionaries
!.idea/inspectionProfiles

*.iml
*.ipr
*.iws

# IntelliJ
out/
# mpeltonen/sbt-idea plugin
.idea_modules/

# JIRA plugin
atlassian-ide-plugin.xml

# Compiled class file
*.class

# Log file
*.log
logs

# BlueJ files
*.ctxt

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*

*~

# temporary files which can be created if a process still has a handle open of a deleted file
.fuse_hidden*

# KDE directory preferences
.directory

# Linux trash folder which might appear on any partition or disk
.Trash-*

# .nfs files are created when an open file is removed but is still being accessed
.nfs*

# General
# Local archives, agent configuration, examples and helper scripts.
/archives/
/.agents/
/examples/
/scripts/

.DS_Store
.AppleDouble
.LSOverride

# Icon must end with two \r
Icon

# Thumbnails
._*

# Files that might appear in the root of a volume
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Directories potentially created on remote AFP share
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# Windows thumbnail cache files
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db

# Dump file
*.stackdump

# Folder config file
[Dd]esktop.ini

# Recycle Bin used on file shares
$RECYCLE.BIN/

# Windows Installer files
*.cab
*.msi
*.msix
*.msm
*.msp

# Windows shortcuts
*.lnk

.gradle
build/

# Ignore Gradle GUI config
gradle-app.setting

# Cache of project
.gradletasknamecache
.cache

**/build/

# Cargo outputs are directed to build/native-physics by Gradle; also ignore manual builds.
/native/**/target/

# Common working directory
run/
runs/

# Avoid ignoring Gradle wrapper jar file (.jar files are usually ignored)
!gradle-wrapper.jar
# The embedded Vector Reflection javaagent is a release build input.
!libs/academy-agent.jar

# Local scratch scripts and notes: ignored only under local-only trees, so new tracked
# files under validation/, tools/ and docs/ stay visible to git status.
/validation/**/*.py
/tools/**/*.py
/docs/**/*.py
/validation/**/*.txt
/tools/**/*.txt
/docs/**/*.txt
*.exe

.vscode
/.kotlin/
node_modules/
/.tmp/
/outputs/
/output/
/asset_backups/
/.codegraph

# Local ability skill effect manual
/docs/AcademyCraft_Reborn_能力技能效果手册.docx
/docs/~$ademyCraft_Reborn_能力技能效果手册.docx

# docs/: only hand-written specifications are tracked.
# Screenshots, capture videos, the HTML galleries, test/reproduction harnesses and
# acceptance evidence all stay local; each document names the script that produces them.
/docs/**/*.png
/docs/**/*.gif
/docs/**/*.mp4
/docs/**/*.webp
/docs/**/*.html
/docs/**/*.jpg

# Test / reproduction harnesses and their recorded output stay local.
/docs/**/*.init.gradle
/docs/**/*.cjs
/docs/**/*.mjs
/docs/**/*.java
/docs/**/*.kt
/docs/**/performance.txt
/docs/models/darkmatter_creature/performance/
/docs/vfx/darkmatter_concept_v2/runtime/

# Acceptance records (验收记录) are local evidence, not specifications.
/docs/aeromanip_vacuum_flow_sense_validation.zh-CN.md
/docs/electromaster_mine_detect_validation.zh-CN.md
/docs/mental_control_work_task_validation.zh-CN.md
